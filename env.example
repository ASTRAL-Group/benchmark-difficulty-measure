# Copy to env.local and source before running:
#   cp env.example env.local && source env.local
#
# Target machine: 8× NVIDIA RTX PRO 6000 Blackwell (~96GB each). Defaults below are already correct (8 GPUs, MiniMax DP serve).

# Repo root (this directory). Override only if scripts are invoked unusually.
export REPO_ROOT="${REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"

# lmms-eval (bundled tarball extracted by scripts/setup_server.sh)
export LMMS_EVAL_REPO="${LMMS_EVAL_REPO:-$REPO_ROOT/vendor/lmms-eval}"

# GPUs for generation + verify
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
export MATH_CUDA_DEVICES="${MATH_CUDA_DEVICES:-$CUDA_VISIBLE_DEVICES}"

# Conda env for MiniMax proposal vLLM (see requirements_diff_minimax.txt)
export CONDA_SERVE_ENV="${CONDA_SERVE_ENV:-diff_minimax}"

# MiniMax OpenAI endpoint (serve_minimax_m2_7_8gpu.sh)
export VLLM_BASE_URL="${VLLM_BASE_URL:-http://127.0.0.1:8010/v1}"
export VLLM_BASE_URLS="${VLLM_BASE_URLS:-$VLLM_BASE_URL}"
export MODEL="${MODEL:-minimax-m2.7}"
